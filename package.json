{
	"name": "sheaf",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types --check && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:regression": "set -e; for check in scripts/*.check.mjs; do node \"$check\"; done",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "wrangler types && prettier --write worker-configuration.d.ts",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"wrangler": "^4.97.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"overrides": {
		"sharp": "^0.35.5"
	},
	"dependencies": {
		"@embedpdf/core": "2.15.1",
		"@embedpdf/engines": "2.15.1",
		"@embedpdf/models": "2.15.1",
		"@embedpdf/plugin-annotation": "2.15.1",
		"@embedpdf/plugin-document-manager": "2.15.1",
		"@embedpdf/plugin-interaction-manager": "2.15.1",
		"@embedpdf/plugin-pan": "2.15.1",
		"@embedpdf/plugin-render": "2.15.1",
		"@embedpdf/plugin-scroll": "2.15.1",
		"@embedpdf/plugin-selection": "2.15.1",
		"@embedpdf/plugin-viewport": "2.15.1",
		"@embedpdf/plugin-zoom": "2.15.1",
		"oauth4webapi": "^3.8.8",
		"phosphor-svelte": "^3.1.0",
		"svelte-sonner": "^1.2.1"
	}
}
