# Local dev only — copy to .dev.vars and fill in. Never commit real values.
ADMIN_PASSWORD=""
SESSION_SECRET=""

# D1 remote access (only needed for drizzle-kit commands against remote D1)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_DATABASE_ID=""
CLOUDFLARE_D1_TOKEN=""

# OIDC login (optional — leave empty to disable OIDC, password login still works)
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
# Match client registration; empty defaults to client_secret_basic.
OIDC_TOKEN_ENDPOINT_AUTH_METHOD=""
OIDC_REDIRECT_URI=""
OIDC_ALLOWED_EMAILS=""
OIDC_ALLOWED_SUBS=""
